<Window x:Class="PaperNotes.IndexWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PaperNotes" Width="880" Height="650" MinWidth="640" MinHeight="440" WindowStartupLocation="CenterScreen"
        Background="#FAF9F6" FontFamily="Yu Gothic UI, Meiryo UI, Microsoft YaHei UI, Segoe UI" FontSize="13" Foreground="#35372F"
        WindowStyle="None" ResizeMode="CanResize">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#E4E5DA"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Card" Background="White" BorderBrush="#E8E7DF" BorderThickness="1" CornerRadius="8" SnapsToDevicePixels="True">
                    <ContentPresenter/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#C8C9BE"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#B0B3A6"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="CategoryTab" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="#6E7168"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="GroupName" Value="NoteCategories"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Border x:Name="Surface" Background="#F1F0EA" CornerRadius="16" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#E6E5DC"/></Trigger>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Surface" Property="Background" Value="#C5D6A8"/>
                        <Setter Property="Foreground" Value="#24301C"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="CategoryAdd" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Foreground" Value="#5E6258"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="ToolTip" Value=""/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="#F1F0EA" CornerRadius="17" SnapsToDevicePixels="True">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#E6E5DC"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#D9D8CE"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="30,28,30,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,18">
            <Button x:Name="SettingsButton" DockPanel.Dock="Right" Content="⚙" ToolTip="Settings" Click="SettingsClick" Margin="0" Padding="10,8" VerticalAlignment="Center"/>
            <StackPanel>
                <TextBlock x:Name="Heading" Text="" FontSize="25" FontWeight="SemiBold"/>
                <TextBlock x:Name="CountLabel" Foreground="#858878" Margin="0,5,0,0"/>
            </StackPanel>
        </DockPanel>

        <DockPanel Grid.Row="1" Margin="0,0,0,12" LastChildFill="True">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                <Button x:Name="NewNoteButton" Content="" Background="#DDE6CB" Click="NewClick" Margin="0,0,6,0"/>
                <!-- TXT import/export handlers remain; toolbar entry is hidden. -->
                <Button x:Name="ImportButton" Content="" Click="ImportClick" Padding="12,8" Margin="0,0,6,0" Visibility="Collapsed"/>
                <Button x:Name="ExportButton" Content="" Click="ExportClick" Padding="12,8" Margin="0" IsEnabled="False" Visibility="Collapsed"/>
            </StackPanel>
            <Border Background="White" BorderBrush="#E4E3DB" BorderThickness="1" CornerRadius="7" Padding="12,8" Margin="16,0,0,0" VerticalAlignment="Center" MinWidth="200">
                <DockPanel>
                    <TextBlock x:Name="SearchLabel" Text="" Foreground="#92958B" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" TextChanged="SearchChanged"/>
                </DockPanel>
            </Border>
        </DockPanel>

        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ScrollViewer x:Name="CategoryScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                          Background="Transparent" BorderThickness="0" Padding="0,0,4,0" VerticalAlignment="Center"
                          PanningMode="HorizontalOnly" PreviewMouseWheel="CategoryWheel">
                <StackPanel x:Name="CategoryBar" Orientation="Horizontal" VerticalAlignment="Center"/>
            </ScrollViewer>
            <Button x:Name="AddCategoryButton" Grid.Column="1" Style="{StaticResource CategoryAdd}" Content="＋" Click="AddCategoryClick" Margin="10,0,0,0"/>
        </Grid>

        <Grid Grid.Row="3">
            <ListBox x:Name="NotesList" BorderThickness="0" Background="Transparent" FocusVisualStyle="{x:Null}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     SelectionMode="Extended" SelectionChanged="SelectionChanged" PreviewMouseLeftButtonUp="NoteClick" KeyDown="NoteKey">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,16,18,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="4" CornerRadius="2" Background="{Binding StripeHex}" VerticalAlignment="Stretch"/>
                            <StackPanel Grid.Column="1">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Timestamp}" FontSize="10" Foreground="#93958A" Margin="12,4,0,0"/>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding CategoryLabel}" FontSize="11" Foreground="#6E7168" Margin="0,4,0,0" VerticalAlignment="Center"
                                               Visibility="{Binding HasCategory, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                                <TextBlock Text="{Binding Preview}" Foreground="#7D8075" TextTrimming="CharacterEllipsis" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="EmptyLabel" Text="" TextAlignment="Center" LineHeight="28" Foreground="#8A8E80" VerticalAlignment="Center" IsHitTestVisible="False"/>
        </Grid>
    </Grid>
</Window>
